<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" fill="none">
  <defs>
    <linearGradient id="bodyGrad" x1="20" y1="30" x2="180" y2="170" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="40%" stop-color="#06b6d4" />
      <stop offset="85%" stop-color="#0284c7" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="bellyGrad" x1="40" y1="90" x2="150" y2="160" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#e0f2fe" />
      <stop offset="50%" stop-color="#67e8f9" />
      <stop offset="100%" stop-color="#0891b2" />
    </linearGradient>
    <linearGradient id="finGrad" x1="70" y1="50" x2="110" y2="20" gradientUnits="userSpaceOnUse">
      <stop offset="0%" stop-color="#06b6d4" />
      <stop offset="100%" stop-color="#a5f3fc" />
    </linearGradient>
    <filter id="neonGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feGaussianBlur stdDeviation="4" result="blur" />
      <feComposite in="SourceGraphic" in2="blur" operator="over" />
    </filter>
  </defs>

  <!-- Ambient Water Glow Splash -->
  <circle cx="100" cy="100" r="75" fill="#06b6d4" opacity="0.15" filter="url(#neonGlow)" />

  <!-- Tail Flukes -->
  <path d="M 32 142 C 22 135, 12 125, 8 116 C 14 126, 26 132, 38 134 C 28 138, 16 148, 12 160 C 18 152, 28 147, 38 144 Z" fill="url(#finGrad)" filter="url(#neonGlow)" />

  <!-- Tail Stock -->
  <path d="M 75 125 C 55 130, 42 135, 34 140 C 40 144, 52 143, 70 138 Z" fill="url(#bodyGrad)" />

  <!-- Dorsal Fin -->
  <path d="M 88 58 C 96 35, 114 24, 126 22 C 120 36, 112 50, 108 59 Z" fill="url(#finGrad)" filter="url(#neonGlow)" />

  <!-- Main Dolphin Body -->
  <path d="M 184 86 C 172 72, 145 56, 108 58 C 72 60, 48 90, 36 138 C 50 142, 68 138, 86 128 C 118 126, 152 116, 172 100 C 182 92, 186 88, 184 86 Z" fill="url(#bodyGrad)" filter="url(#neonGlow)" />

  <!-- Dolphin Underbelly -->
  <path d="M 174 94 C 160 106, 130 120, 94 122 C 68 124, 50 134, 42 138 C 50 125, 68 106, 100 95 C 130 85, 160 88, 174 94 Z" fill="url(#bellyGrad)" opacity="0.9" />

  <!-- Beak / Snout highlight -->
  <path d="M 184 86 C 188 89, 186 92, 178 95 C 180 91, 182 88, 184 86 Z" fill="#cffafe" />

  <!-- Pectoral Fin -->
  <path d="M 112 98 C 118 116, 128 130, 142 138 C 134 128, 126 112, 124 97 Z" fill="url(#finGrad)" filter="url(#neonGlow)" />

  <!-- Friendly Eye -->
  <ellipse cx="152" cy="78" rx="5" ry="6" fill="#0f172a" />
  <circle cx="154" cy="76" r="2" fill="#ffffff" />
  <circle cx="150" cy="81" r="0.8" fill="#67e8f9" />

  <!-- Smile Curve -->
  <path d="M 172 91 C 168 94, 162 95, 158 93" stroke="#0891b2" stroke-width="1.8" stroke-linecap="round" />

  <!-- Playful Water Droplets & Bubbles -->
  <circle cx="168" cy="52" r="3.5" fill="#a5f3fc" opacity="0.8" />
  <circle cx="180" cy="64" r="2" fill="#67e8f9" opacity="0.9" />
  <circle cx="62" cy="46" r="2.5" fill="#38bdf8" opacity="0.7" />
  <circle cx="45" cy="80" r="3" fill="#a5f3fc" opacity="0.6" />
</svg>
